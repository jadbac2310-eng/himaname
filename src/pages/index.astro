---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  inLanguage: SITE.lang,
  publisher: { '@id': `${SITE.url}/#organization` },
  blogPost: posts.slice(0, 20).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/posts/${p.id}/`, SITE.url).href,
    datePublished: new Date(p.data.pubDate).toISOString(),
  })),
};

const TOOLS = [
  ['⚔️', 'かっこいい名前', '/tools/rpg-name'],
  ['🔥', '二つ名', '/tools/futatsuna'],
  ['💥', '技名・必殺技', '/tools/skill-name'],
  ['🛡️', 'ギルド名', '/tools/guild-name'],
  ['👥', 'チーム名', '/tools/team-name'],
  ['💬', 'サーバー名', '/tools/server-name'],
  ['🆔', 'ID・名前', '/tools/player-id'],
  ['✨', '文字装飾', '/tools/fancy-text'],
  ['🎰', 'ガチャ', '/tools/gacha'],
  ['⛩️', 'おみくじ', '/tools/omikuji'],
  ['🎡', 'ルーレット', '/tools/roulette'],
  ['🪜', 'あみだくじ', '/tools/amidakuji'],
];
---
<BaseLayout title={SITE.name} description={SITE.description} jsonLd={[blogSchema]}>
  <h1 class="post-title">{SITE.name}</h1>
  <p class="post-meta">名前のアイデアと、ちょっとした暇つぶし。毎日更新中。</p>
  <section class="home-tools" aria-label="無料ツール">
    <div class="home-tools-head"><h2>🎮 無料ツール</h2><a href="/tools">すべて見る →</a></div>
    <div class="tool-grid">
      {TOOLS.map(([ico, name, href]) => (
        <a href={href}><span class="ico">{ico}</span>{name}</a>
      ))}
    </div>
  </section>
  {posts.length === 0 && <p>記事はまだありません。</p>}
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a href={`/posts/${p.id}/`} class="post-card">
          <img
            class="thumb"
            src={p.data.heroImage || '/og-default.svg'}
            alt=""
            width="120"
            height="80"
            loading="lazy"
            decoding="async"
          />
          <span class="post-card-body">
            <span class="date">{fmt(p.data.pubDate)}</span>
            <span class="post-card-title">{p.data.title}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
