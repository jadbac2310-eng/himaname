---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../consts';

const crumbs = [
  { name: 'ホーム', href: '/' },
  { name: 'ツール', href: '/tools' },
];
const tools = [
  { href: '/tools/rpg-name', title: 'RPG風 かっこいい名前ジェネレーター', desc: 'クラウド型・神話型・幻想造語の3系統。キャラ名やIDに。' },
  { href: '/tools/guild-name', title: 'かっこいいギルド名メーカー', desc: 'ギルド名・チーム名・クラン名を英語＆ラテン語で。' },
  { href: '/tools/futatsuna', title: '二つ名・異名ジェネレーター', desc: '「蒼炎の剣聖」「深淵を覗く者」中二な二つ名をよみがな付きで。' },
  { href: '/tools/skill-name', title: '技名・必殺技メーカー', desc: '「滅却斬」「Crimson Fang」中二な技名・必殺技を。' },
  { href: '/tools/team-name', title: 'チーム名・パーティー名ジェネレーター', desc: '「The Crimson Ravens」かっこいい英語のチーム名。' },
  { href: '/tools/server-name', title: 'Discordサーバー名メーカー', desc: '「Velvet Lounge」おしゃれ・かわいいサーバー名。' },
  { href: '/tools/player-id', title: 'ID・プレイヤーネームメーカー', desc: '「ShadowFox」おしゃれ＆かっこいいゲームID。' },
];
---
<BaseLayout title={`無料ツール一覧 | ${SITE.name}`} description="かっこいい名前・ギルド名を作る無料ジェネレーター一覧。">
  <Breadcrumbs items={crumbs} />
  <h1 class="post-title">無料ツール一覧</h1>
  <p class="post-meta">かっこいい名前づくりを助ける無料ジェネレーター。</p>
  <ul class="post-list">
    {tools.map((t) => (
      <li>
        <a href={t.href}><strong>⚔ {t.title}</strong></a>
        <div style="color:var(--muted);font-size:13px;margin-top:4px">{t.desc}</div>
      </li>
    ))}
  </ul>
</BaseLayout>
