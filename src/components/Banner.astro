---
// 自社ゲーム「ぼくとネコ」のバナー。画像/altは .env の BANNER_IMAGE_URL / BANNER_ALT を参照。
const img = import.meta.env.BANNER_IMAGE_URL || '/images/game-banner.webp';
// Adjust計測リンク。端末判定でApp Store/Google Playに自動振り分けされるため1本でよい。
// 環境変数にすると設定漏れで古いリンクのまま配信される事故が起きたため、意図的にハードコード。
const link = 'https://app.adjust.com/21imrv6r';
const alt = import.meta.env.BANNER_ALT || 'ぼくとネコ｜おすすめネコゲー、いますぐダウンロード';
const { label = '── ちょっと一息、ヤバかわネコの大バトルで暇つぶし ──' } = Astro.props;
---
<a class="banner" href={link} target="_blank" rel="noopener sponsored">
  <span class="label">{label}</span>
  <img src={img} alt={alt} loading="lazy" />
</a>
