# ===== 記事生成に必要なキー（このファイルを .env にコピーして値を入れる）=====

# Claude API（本文生成）  https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 使用モデル（任意）。未指定なら claude-sonnet-4-6
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI API（gpt-image による画像生成）  https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxx
# 画像モデル（任意）。未指定なら gpt-image-1
IMAGE_MODEL=gpt-image-1

# ===== 自社ゲーム「ぼくとネコ」のバナー =====
# バナー画像（public/images/game-banner.webp に実画像を置く。外部URLでも可）
BANNER_IMAGE_URL=/images/game-banner.webp
# バナーの代替テキスト（任意）
BANNER_ALT=ぼくとネコ｜おすすめネコゲー、いますぐダウンロード

# ===== サイト設定 =====
SITE_URL=https://himaname.com
SITE_NAME=ひまつぶし・ネーミング研究所
